# Database connection string
# For production (Render/Railway/etc), this is provided automatically
# For local development, get from your cloud dashboard or use local PostgreSQL
DATABASE_URL="postgresql://user:password@host:port/database"

# Server port (optional, defaults to 3000)
PORT=3000

# Environment
NODE_ENV=development

# Study data source
# Default: PITCH benchmark data from GitHub
# Override with your own data source:
#   - GitHub raw URL: https://raw.githubusercontent.com/your-username/your-data-repo/main/pitch-benchmark-data.json
#   - Local file: ./pitch-benchmark-data.json
#   - Any public URL: https://example.com/path/to/data.json
STUDY_DATA_URL=https://raw.githubusercontent.com/gobrianyu/pitch/master/data/pitch-benchmark-data.json
